{
  "name": "genqr-wp",
  "private": true,
  "description": "GenQR WordPress plugin: QR codes and short links",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "playground": "wp-playground-cli server --port=9400 --mount=./plugin/genqr:/wordpress/wp-content/plugins/genqr --blueprint=./playground/blueprint.json --login"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@wp-playground/cli": "3.1.58",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "docx": "^9.12.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "preact": "^11.0.1",
    "qrcode": "^1.5.4"
  },
  "type": "module",
  "allowScripts": {
    "esbuild": true
  }
}
